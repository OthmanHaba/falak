{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.create.schema.json",
  "title": "db.create — create database if missing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "name"
  ],
  "properties": {
    "engine": {
      "enum": [
        "mysql",
        "postgres"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
    },
    "charset": {
      "type": "string",
      "default": "utf8mb4"
    },
    "collation": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        }
      }
    }
  }
}
