{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/runtime.bun.install.schema.json",
  "title": "runtime.bun.install \u2014 install the official Bun binary into /opt/falak/bun/<version>",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Optional; when absent the agent verifies against the release SHASUMS256.txt"
    },
    "default": {
      "type": "boolean",
      "default": false,
      "description": "Symlink bun into /usr/local/bin"
    },
    "mirror": {
      "type": "string",
      "format": "uri",
      "default": "https://github.com/oven-sh/bun/releases/download"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "prefix"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "prefix": {
          "type": "string"
        }
      }
    }
  }
}
