{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.instance.password.schema.json",
  "title": "db.instance.password — rotate the superuser / root / default password: written to /run/secrets/.password.new, set by `falak-db password set`, then it replaces the password file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "engine",
    "password"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "valkey"
      ]
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "secret"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "starting",
            "none"
          ]
        }
      }
    }
  }
}
