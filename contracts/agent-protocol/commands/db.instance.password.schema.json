{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.instance.password.schema.json",
  "title": "db.instance.password — rotate the superuser / root / default password: written to /run/secrets/.password.new, set by `falak-db password set`, then it replaces the password file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "engine"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "valkey"
      ]
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "secret"
    },
    "mode": {
      "enum": [
        "replace",
        "add",
        "retire"
      ],
      "default": "replace",
      "description": "replace: the new password replaces the current one; add (redis / valkey): the new one is added next to the current one, which stays valid (across restarts too) until retire; retire: every password but the current one is dropped (no `password` needed). Idempotent: a retry after a failed file swap finishes it"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "starting",
            "none"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "retire"
          }
        },
        "required": [
          "mode"
        ]
      },
      "else": {
        "required": [
          "password"
        ]
      }
    }
  ]
}
