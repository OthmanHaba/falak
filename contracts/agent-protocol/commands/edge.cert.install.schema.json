{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.dev/agent-protocol/commands/edge.cert.install.schema.json",
  "title": "edge.cert.install — custom TLS certificate stored under /etc/kiln/certs/<name>.{crt,key}",
  "x-kiln-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "cert_pem": {
      "type": "string",
      "pattern": "-----BEGIN CERTIFICATE-----"
    },
    "key_pem": {
      "type": "string",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    },
    "chain_pem": {
      "type": "string"
    },
    "state": {
      "enum": [
        "present",
        "absent"
      ],
      "default": "present"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "not_after": {
          "type": "string",
          "format": "date-time"
        },
        "cert_path": {
          "type": "string"
        },
        "key_path": {
          "type": "string"
        }
      }
    }
  }
}
