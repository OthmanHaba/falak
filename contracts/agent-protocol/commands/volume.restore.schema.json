{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/volume.restore.schema.json",
  "title": "volume.restore — download a volume.archive snapshot (sha256 checked) into a new or empty volume, created when missing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume",
    "source",
    "sha256"
  ],
  "properties": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{26}$",
          "description": "The volume's id (lower-case ULID)"
        },
        "kind": {
          "enum": [
            "docker",
            "sized",
            "bind",
            "shared_path"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "description": "docker: the Docker volume's name"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\x00]*$",
          "maxLength": 4096,
          "description": "bind: the host path (within the agent's FALAK_VOLUME_BIND_ALLOW); shared_path: the site's shared path (under the sites root). sized volumes live at /var/lib/falak/volumes/<id>"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "docker"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "bind",
                  "shared_path"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 16777216,
      "maximum": 17592186044416,
      "description": "sized: the image file's size in bytes (16 MiB – 16 TiB)"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "const": "url"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uncompressed_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "The snapshot's unpacked size, checked against the free space"
    },
    "archive_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "The snapshot's recorded (compressed) size: a download larger than it (+1 MiB) is aborted"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "files": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        }
      }
    }
  }
}
