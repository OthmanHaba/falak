{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/volume.create.schema.json",
  "title": "volume.create — create a Docker named volume, a sized volume (ext4 image loop-mounted by a systemd mount unit) or check a bind path; idempotent",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume"
  ],
  "properties": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{26}$",
          "description": "The volume's id (lower-case ULID)"
        },
        "kind": {
          "enum": [
            "docker",
            "sized",
            "bind",
            "shared_path"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "description": "docker: the Docker volume's name"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\x00]*$",
          "maxLength": 4096,
          "description": "bind: the host path (within the agent's FALAK_VOLUME_BIND_ALLOW); shared_path: the site's shared path (under the sites root). sized volumes live at /var/lib/falak/volumes/<id>"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "docker"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "bind",
                  "shared_path"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 16777216,
      "maximum": 17592186044416,
      "description": "sized: the image file's size in bytes (16 MiB – 16 TiB)"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "adopt": {
      "type": "boolean",
      "default": false,
      "description": "docker: take over an existing Docker volume that does not carry this volume's falak.volume.id label (otherwise refused)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "volume": {
            "properties": {
              "kind": {
                "const": "sized"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "size_bytes"
        ]
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "created"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Where the data lives on the host (mountpoint, Docker's _data directory or the bind path)"
        },
        "size_bytes": {
          "type": "integer"
        },
        "created": {
          "type": "boolean",
          "description": "false when it already existed"
        }
      }
    }
  }
}
