{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.backup.schema.json",
  "title": "db.backup — stream `falak-db backup logical` out of an instance's container (postgres pg_dump -Fc, mysql/mariadb dump, redis/valkey RDB snapshot), compress, write to a local path or PUT to a presigned URL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "engine",
    "database",
    "destination"
  ],
  "properties": {
    "instance": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "valkey"
      ]
    },
    "database": {
      "type": "string",
      "description": "SQL: the database (identifier). Redis / Valkey: the instance's database row name, informational"
    },
    "compression": {
      "enum": [
        "gzip",
        "none"
      ],
      "default": "gzip"
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "presigned_url"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "enum": [
              "postgres",
              "mysql",
              "mariadb"
            ]
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "sha256",
        "location"
      ],
      "properties": {
        "size_bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "rdb": {
          "type": "string",
          "pattern": "^(REDIS[0-9]{4}|VALKEY[0-9]{3})$",
          "description": "Redis / Valkey: the snapshot's RDB header (format and version)"
        },
        "uncompressed_bytes": {
          "type": "integer",
          "description": "The dump's size before compression (a Redis / Valkey restore gets it back as uncompressed_bytes)"
        }
      }
    }
  }
}
