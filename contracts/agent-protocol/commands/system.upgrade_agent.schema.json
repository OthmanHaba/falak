{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/system.upgrade_agent.schema.json",
  "title": "system.upgrade_agent — download (sha256-verified), pre-flight `<new> version`, swap atomically (previous kept as <bin>.prev) and restart",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "url",
    "sha256"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Version the control plane ships (release tag, or a dev/CI build id); the result reports what the new binary prints"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Binary for this host's arch"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "restart": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "version"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "previous_version": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
