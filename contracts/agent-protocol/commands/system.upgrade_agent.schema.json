{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.dev/agent-protocol/commands/system.upgrade_agent.schema.json",
  "title": "system.upgrade_agent — replace the agent binary and restart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "url",
    "sha256"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Binary for this host's arch"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "restart": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "version"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "previous_version": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
