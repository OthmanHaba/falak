{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.instance.secrets.schema.json",
  "title": "db.instance.secrets — put an instance's password file back after a reboot emptied /run (heartbeat databases[].secrets_missing) and start its container; a present directory is left alone",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "engine",
    "password"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "valkey"
      ]
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "secret"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restored",
        "started"
      ],
      "properties": {
        "restored": {
          "type": "boolean"
        },
        "started": {
          "type": "boolean"
        }
      }
    }
  }
}
