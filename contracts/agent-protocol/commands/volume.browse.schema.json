{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/volume.browse.schema.json",
  "title": "volume.browse — list a directory of a volume, or search it by name (read-only; confined to the volume)",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume"
  ],
  "properties": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{26}$",
          "description": "The volume's id (lower-case ULID)"
        },
        "kind": {
          "enum": [
            "docker",
            "sized",
            "bind",
            "shared_path"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "description": "docker: the Docker volume's name"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\x00]*$",
          "maxLength": 4096,
          "description": "bind: the host path (within the agent's FALAK_VOLUME_BIND_ALLOW); shared_path: the site's shared path (under the sites root). sized volumes live at /var/lib/falak/volumes/<id>"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "docker"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "bind",
                  "shared_path"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^([^/\\x00][^\\x00]*)?$",
      "default": "",
      "description": "Relative to the volume's root; no '.' or '..' segments. Symlinks are never followed out of the volume."
    },
    "search": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Case-insensitive name substring, searched below path"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 200
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "entries",
        "total"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "type",
              "size",
              "mtime"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Relative to the volume's root"
              },
              "type": {
                "enum": [
                  "file",
                  "dir",
                  "symlink",
                  "other"
                ]
              },
              "size": {
                "type": "integer"
              },
              "mtime": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "total": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
