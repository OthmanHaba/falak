{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/net.wireguard.apply.schema.json",
  "title": "net.wireguard.apply — WireGuard interface for the private network (keys generated on host if absent)",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "address",
    "peers"
  ],
  "properties": {
    "interface": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,15}$",
      "default": "wg-falak"
    },
    "address": {
      "type": "string",
      "description": "CIDR, e.g. 10.90.0.3/24"
    },
    "listen_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 51820
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_key",
          "allowed_ips"
        ],
        "properties": {
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{42,43}=$"
          },
          "endpoint": {
            "type": "string"
          },
          "allowed_ips": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "persistent_keepalive": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "state": {
      "enum": [
        "present",
        "absent"
      ],
      "default": "present"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "public_key": {
          "type": "string"
        }
      }
    }
  }
}
