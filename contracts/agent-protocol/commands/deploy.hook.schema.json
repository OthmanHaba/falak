{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/deploy.hook.schema.json",
  "title": "deploy.hook — run a deploy script step with FALAK_* env",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "release_id",
    "name",
    "script"
  ],
  "properties": {
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Site slug (directory name under /srv/falak/sites)"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID"
    },
    "sites_root": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^/"
        }
      ],
      "default": "/srv/falak/sites"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "examples": [
        "build",
        "migrate",
        "after_activate"
      ]
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "description": "$FALAK_FETCH/$FALAK_ACTIVATE/$FALAK_RESTART_PROCS are split out by the control plane and are no-ops (':') here"
    },
    "shell": {
      "type": "string",
      "default": "/bin/bash"
    },
    "user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "cwd": {
      "enum": [
        "release",
        "current",
        "site_root"
      ],
      "default": "release"
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "site_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID"
        },
        "commit": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "trigger": {
          "enum": [
            "push",
            "manual",
            "api",
            "rollback",
            "schedule"
          ]
        },
        "php_binary": {
          "type": "string",
          "description": "e.g. /usr/bin/php8.4 or 'frankenphp php-cli'"
        }
      },
      "description": "Deployment context. Labels the deployment lifecycle OTLP log events (falak.event.type=deployment, falak.deployment.id, falak.site.id, falak.release.id, falak.deployment.phase, falak.deployment.status); in deploy.hook also exposed to scripts as FALAK_SITE_ID, FALAK_DEPLOYMENT_ID, FALAK_COMMIT, FALAK_AUTHOR, FALAK_BRANCH, FALAK_TRIGGER, FALAK_PHP_BINARY"
    },
    "mask": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Names of the secret variables in this payload. The agent looks their values up in the payload (env maps, dotenv content) and masks them, plus their base64 and URL-encoded forms, as •••• in the command's output, error and result. Values shorter than 6 bytes are not masked. deploy.hook also masks the values of these names in the site's env file, which scripts read."
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        }
      }
    }
  }
}
