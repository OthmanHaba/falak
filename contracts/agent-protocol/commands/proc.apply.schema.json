{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/proc.apply.schema.json",
  "title": "proc.apply — full desired set of supervised processes (built-in supervisor)",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programs"
  ],
  "properties": {
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "argv; use [\"/bin/sh\",\"-c\",\"...\"] for shell"
          },
          "user": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
          },
          "cwd": {
            "type": "string",
            "pattern": "^/"
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "numprocs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 1
          },
          "autostart": {
            "type": "boolean",
            "default": true
          },
          "restart": {
            "enum": [
              "always",
              "on-failure",
              "never"
            ],
            "default": "always"
          },
          "backoff": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "initial_ms": {
                "type": "integer",
                "minimum": 10,
                "default": 1000
              },
              "max_ms": {
                "type": "integer",
                "minimum": 10,
                "default": 60000
              }
            }
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0,
            "default": 1,
            "description": "Process must stay up this long to reset backoff"
          },
          "stop_signal": {
            "enum": [
              "TERM",
              "INT",
              "QUIT",
              "HUP",
              "KILL",
              "USR1",
              "USR2"
            ],
            "default": "TERM"
          },
          "stop_timeout_s": {
            "type": "integer",
            "minimum": 1,
            "default": 30,
            "description": "SIGKILL after this"
          },
          "log": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "stdout": {
                "type": "string",
                "pattern": "^/"
              },
              "stderr": {
                "type": "string",
                "pattern": "^/"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 0,
                "default": 52428800
              },
              "otlp": {
                "type": "boolean",
                "default": true
              },
              "max_files": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 1,
                "description": "Rotated files kept (<log>.1 … <log>.N)"
              }
            }
          },
          "site": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "description": "Site slug (directory name under /srv/falak/sites)"
          },
          "mask": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "uniqueItems": true,
            "description": "Names of the secret variables of env: their values are masked (••••) in the program's log files and OTLP log records, and kept on the tmpfs, never in the agent's proc.json; after a reboot the program waits (heartbeat missing_secrets) until proc.apply sends it again."
          },
          "slice": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$",
            "description": "Runs every instance in this slice of `slices` (a transient scope falak-proc-<name>-<i>.scope via systemd-run; setpriv drops to `user`); omitted = the agent's own cgroup"
          },
          "oom_score_adj": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000,
            "default": 0,
            "description": "OOM preference of the instances (negative = killed last)"
          },
          "max_restarts": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "After this many restarts in a row that never reached start_seconds, the instance stops in state fatal (0 = keep restarting)"
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "maxItems": 1000,
      "description": "The full desired set of Falak slices (resource limits of programs and of sites' own PHP-FPM masters). Written to /etc/systemd/system/falak-<name>.slice and applied live (systemctl set-property --runtime) before the programs converge; managed slices not listed are removed afterwards (an active one only loses its limits). An invalid slice is skipped and reported in the result's slice_errors, never the whole set.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,80}$",
            "description": "Slice key: the unit is falak-<name>.slice under falak.slice (no dashes: a dash nests a slice under another)"
          },
          "memory_max_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "MemoryMax= (hard limit; swap off on top of it)"
          },
          "memory_high_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "MemoryHigh= (throttled and reclaimed above it)"
          },
          "memory_low_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "MemoryLow= (protected from reclaim: the reservation)"
          },
          "cpu_quota_percent": {
            "type": "integer",
            "minimum": 0,
            "description": "CPUQuota= (100 = one CPU)"
          },
          "tasks_max": {
            "type": "integer",
            "minimum": 0,
            "description": "TasksMax="
          }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "started": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stopped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restarted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Slices whose limits changed (applied live) or that were removed"
        },
        "slice_errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Slices skipped (invalid limits, a duplicate, set-property failed, or not declared), by name: their programs run without them and a failed slice keeps its previous unit. The other slices and every program are applied."
        }
      }
    }
  }
}
