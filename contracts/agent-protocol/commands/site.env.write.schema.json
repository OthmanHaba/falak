{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/site.env.write.schema.json",
  "title": "site.env.write — restore a site's secrets on the tmpfs (after a reboot) without deploying",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site"
  ],
  "properties": {
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Site slug"
    },
    "sites_root": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^/"
        }
      ],
      "default": "/srv/falak/sites"
    },
    "env_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "dotenv content of the live release (secret)"
        },
        "path": {
          "type": "string",
          "default": ".env",
          "description": "Link in shared/ (as in deploy.prepare)"
        }
      },
      "description": "Written to /run/falak/env/<site>.env (0440, site user and group); shared/<path> is (re)made a symlink to it"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        }
      },
      "description": "Owner of the env file"
    },
    "secret_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "File name under /run/secrets (the variable's name)"
          },
          "content": {
            "type": "string",
            "description": "secret"
          }
        }
      },
      "description": "Written into the secret directory of every container labelled falak.site=<site> with secret files; a container that could not start without them is started."
    },
    "mask": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Names of the secret variables in this payload. The agent looks their values up in the payload (env maps, dotenv content) and masks them, plus their base64 and URL-encoded forms, as •••• in the command's output, error and result. Values shorter than 6 bytes are not masked."
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "containers"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Containers whose secret files were written"
        }
      }
    }
  }
}
