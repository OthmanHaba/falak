{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.user.apply.schema.json",
  "title": "db.user.apply — converge a user of an instance and its grants (full desired set: grants not listed are revoked); the spec goes to falak-db user apply as a file in the instance's secrets directory",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "engine",
    "username"
  ],
  "properties": {
    "instance": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb"
      ]
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "secret; required when state=present"
    },
    "host": {
      "type": "string",
      "default": "%",
      "description": "mysql / mariadb only"
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "database"
        ],
        "properties": {
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          },
          "privileges": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z ]+$"
            },
            "minItems": 1,
            "default": [
              "ALL PRIVILEGES"
            ]
          }
        }
      }
    },
    "state": {
      "enum": [
        "present",
        "absent"
      ],
      "default": "present"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the instance's state was modified"
        }
      }
    }
  }
}
