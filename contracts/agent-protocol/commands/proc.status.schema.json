{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/proc.status.schema.json",
  "title": "proc.status — report supervised process state",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processes"
      ],
      "properties": {
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "instance",
              "state"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "instance": {
                "type": "integer"
              },
              "pid": {
                "type": "integer"
              },
              "state": {
                "enum": [
                  "starting",
                  "running",
                  "backoff",
                  "stopping",
                  "stopped",
                  "exited",
                  "fatal"
                ]
              },
              "restarts": {
                "type": "integer"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "last_exit_code": {
                "type": "integer"
              },
              "launch_error": {
                "type": "string",
                "description": "The last start never ran the program: its slice's scope could not be created, systemd-run / choom / setpriv is missing, or the user may not enter its directory"
              }
            }
          }
        }
      }
    }
  }
}
