{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.restore.schema.json",
  "title": "db.restore — load an FKB1 backup into a database of an instance (`falak-db restore logical`; postgres swapped in from a scratch database; redis/valkey: the instance stops, a one-off container of its image replaces the snapshot, it starts again)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "engine",
    "database",
    "encryption",
    "source",
    "sha256"
  ],
  "properties": {
    "instance": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "valkey"
      ]
    },
    "database": {
      "type": "string"
    },
    "encryption": {
      "$ref": "#/$defs/encryption"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "the stored file's SHA-256 (required): checked after the download, then the whole file is authenticated before anything is restored"
    },
    "plaintext_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "the dump's SHA-256, checked against the file's authenticated trailer"
    },
    "archive_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "the stored file's size: the staging directory (on the volume store) must have room for it"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "description": "postgres: the role that gets the restored database and every object in it (the application's user). PostgreSQL restores load into a scratch database renamed into place only on success"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "enum": [
              "postgres",
              "mysql",
              "mariadb"
            ]
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "encryption": {
      "description": "opens an FKB1 backup: cp with the data key the control plane unwrapped; age with the customer's identity, given for this command only (never stored by the control plane)",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "key_id",
            "key"
          ],
          "properties": {
            "mode": {
              "const": "cp"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._:-]{0,127}$",
              "description": "the backup's key id (its id): written in the file's header and checked when it is opened"
            },
            "key": {
              "type": "string",
              "minLength": 32,
              "maxLength": 88,
              "description": "secret: the 32-byte data key, base64 (or hex). The agent keeps it in memory only"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "key_id",
            "identity"
          ],
          "properties": {
            "mode": {
              "const": "age"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._:-]{0,127}$",
              "description": "the backup's key id (its id): written in the file's header and checked when it is opened"
            },
            "identity": {
              "type": "string",
              "pattern": "^AGE-SECRET-KEY-1[02-9AC-HJ-NP-Z]{58}$",
              "description": "secret: the customer's age X25519 identity (private key)"
            }
          }
        }
      ]
    }
  }
}
