{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.restore.schema.json",
  "title": "db.restore — load a backup into a database of an instance (`falak-db restore logical`; postgres with --clean; redis/valkey: the instance stops, a one-off container of its image replaces the snapshot, it starts again)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "engine",
    "database",
    "source"
  ],
  "properties": {
    "instance": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "redis",
        "valkey"
      ]
    },
    "database": {
      "type": "string"
    },
    "compression": {
      "enum": [
        "gzip",
        "none"
      ],
      "default": "gzip"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "enum": [
              "postgres",
              "mysql",
              "mariadb"
            ]
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
