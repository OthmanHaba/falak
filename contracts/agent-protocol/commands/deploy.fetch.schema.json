{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.dev/agent-protocol/commands/deploy.fetch.schema.json",
  "title": "deploy.fetch — download + verify + extract release artifact into releases/<release_id>",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "release_id",
    "artifact"
  ],
  "properties": {
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Site slug (directory name under /srv/kiln/sites)"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID"
    },
    "sites_root": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^/"
        }
      ],
      "default": "/srv/kiln/sites"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "enum": [
            "tar.gz",
            "tar.zst",
            "tar"
          ],
          "default": "tar.gz"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "e.g. Authorization for the artifact store"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        }
      },
      "description": "Owner applied to created files/dirs"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "release_dir"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "release_dir": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        }
      }
    }
  }
}
