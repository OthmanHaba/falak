{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.dev/agent-protocol/commands/runtime.frankenphp.configure.schema.json",
  "title": "runtime.frankenphp.configure — install the static FrankenPHP binary and its php.ini",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ini": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "as_edge": {
      "type": "boolean",
      "default": true,
      "description": "Run kiln-edge.service with frankenphp (a Caddy build) instead of caddy; admin API stays on localhost:2019"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "binary"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "binary": {
          "type": "string"
        }
      }
    }
  }
}
