{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.instance.upgrade.schema.json",
  "title": "db.instance.upgrade — a major version upgrade: copy every database from the source instance into the (created, empty) target with falak-db backup logical | restore logical, apply the users there, move the source's DNS alias to the target and stop the source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "source",
    "target",
    "databases",
    "alias"
  ],
  "properties": {
    "mode": {
      "const": "major"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "engine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{26}$"
        },
        "engine": {
          "enum": [
            "postgres",
            "mysql",
            "mariadb"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "engine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{26}$"
        },
        "engine": {
          "enum": [
            "postgres",
            "mysql",
            "mariadb"
          ]
        }
      }
    },
    "databases": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          },
          "charset": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          },
          "collation": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          }
        }
      }
    },
    "users": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "secret"
          },
          "host": {
            "type": "string",
            "description": "mysql / mariadb account host (default %)"
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "database"
              ],
              "properties": {
                "database": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
                },
                "privileges": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z ]+$"
                  },
                  "minItems": 1,
                  "default": [
                    "ALL PRIVILEGES"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "string",
      "pattern": "^falak-env-[0-9a-z]{26}$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databases"
      ],
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "bytes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              }
            }
          }
        },
        "duration_ms": {
          "type": "integer"
        }
      }
    }
  }
}
