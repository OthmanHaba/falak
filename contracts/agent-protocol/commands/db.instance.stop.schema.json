{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.instance.stop.schema.json",
  "title": "db.instance.stop — stop the container (60 s to shut down); it stays stopped",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "starting",
            "none"
          ]
        }
      }
    }
  }
}
