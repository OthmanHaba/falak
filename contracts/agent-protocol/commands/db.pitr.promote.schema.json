{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/db.pitr.promote.schema.json",
  "title": "db.pitr.promote — a restored instance the user keeps becomes writable (its read-only settings dropped and the container restarted, `falak-db readonly off`, the inspection account dropped); with stop (a swap), the instance it replaces is stopped (kept, with its volume) and ships nothing more",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "engine"
  ],
  "properties": {
    "instance": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "engine": {
      "enum": [
        "postgres",
        "mysql",
        "mariadb"
      ]
    },
    "stop": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "inspection_user": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "description": "the copy's read-only inspection account, dropped"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "health": {
          "type": "string"
        }
      }
    }
  }
}
