{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/docker.compose.restart.schema.json",
  "title": "docker.compose.restart — restart the containers of a compose project (all or the listed services)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
      },
      "description": "Default: every service"
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600,
      "default": 10
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restarted"
      ],
      "properties": {
        "restarted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
