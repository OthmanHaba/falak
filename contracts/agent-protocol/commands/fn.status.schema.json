{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/fn.status.schema.json",
  "title": "fn.status — instances and counters of the server's functions (from falak-fn-gateway)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Only this function (default: all)"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functions"
      ],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "site",
              "release",
              "running",
              "starting",
              "in_flight",
              "cold_starts",
              "requests"
            ],
            "properties": {
              "site": {
                "type": "string"
              },
              "release": {
                "type": "string"
              },
              "running": {
                "type": "integer",
                "minimum": 0
              },
              "starting": {
                "type": "integer",
                "minimum": 0
              },
              "in_flight": {
                "type": "integer",
                "minimum": 0
              },
              "cold_starts": {
                "type": "integer",
                "minimum": 0
              },
              "requests": {
                "type": "integer",
                "minimum": 0
              },
              "last_request_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
