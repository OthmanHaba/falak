{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/system.user.create.schema.json",
  "title": "system.user.create — ensure a unix user exists (never deletes)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "uid": {
      "type": "integer",
      "minimum": 0
    },
    "shell": {
      "type": "string",
      "default": "/bin/bash"
    },
    "home": {
      "type": "string",
      "pattern": "^/"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "uniqueItems": true,
      "description": "Supplementary groups (created if missing)"
    },
    "system": {
      "type": "boolean",
      "default": false
    },
    "sudo": {
      "enum": [
        "none",
        "nopasswd"
      ],
      "default": "none",
      "description": "Writes/removes /etc/sudoers.d/falak-<name>"
    },
    "isolated": {
      "type": "boolean",
      "default": false,
      "description": "Home dir mode 0750 so other site users cannot read it"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "uid": {
          "type": "integer"
        },
        "home": {
          "type": "string"
        }
      }
    }
  }
}
