{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/volume.delete.schema.json",
  "title": "volume.delete — remove a volume and its data: unmount and remove a sized volume's unit and image, docker volume rm; bind paths are only forgotten",
  "x-falak-redeliverable": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "volume"
  ],
  "properties": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-z]{26}$",
          "description": "The volume's id (lower-case ULID)"
        },
        "kind": {
          "enum": [
            "docker",
            "sized",
            "bind",
            "shared_path"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "description": "docker: the Docker volume's name"
        },
        "path": {
          "type": "string",
          "pattern": "^/[^\\x00]*$",
          "maxLength": 4096,
          "description": "bind: the host path (within the agent's FALAK_VOLUME_BIND_ALLOW); shared_path: the site's shared path (under the sites root). sized volumes live at /var/lib/falak/volumes/<id>"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "docker"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "bind",
                  "shared_path"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "wait_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600,
      "default": 0,
      "description": "Wait up to this long for running containers mounting the volume to go away (a service deleted just before)"
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Delete even while running containers mount it (sized: lazy unmount)"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deleted",
        "existed"
      ],
      "properties": {
        "deleted": {
          "type": "boolean"
        },
        "existed": {
          "type": "boolean"
        }
      }
    }
  }
}
