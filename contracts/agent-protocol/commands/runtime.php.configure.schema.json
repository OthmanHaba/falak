{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.dev/agent-protocol/commands/runtime.php.configure.schema.json",
  "title": "runtime.php.configure — php.ini overrides written to conf.d/99-kiln.ini (full desired set)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ini"
  ],
  "properties": {
    "version": {
      "enum": [
        "7.4",
        "8.0",
        "8.1",
        "8.2",
        "8.3",
        "8.4",
        "8.5"
      ]
    },
    "sapi": {
      "enum": [
        "fpm",
        "cli",
        "all"
      ],
      "default": "all"
    },
    "ini": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_.]+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
