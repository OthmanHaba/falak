{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/commands/deploy.rollback.schema.json",
  "title": "deploy.rollback — point `current` at an earlier release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site"
  ],
  "properties": {
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Site slug (directory name under /srv/falak/sites)"
    },
    "sites_root": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^/"
        }
      ],
      "default": "/srv/falak/sites"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Target; default = newest release older than current"
    },
    "reload": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "php_fpm",
              "systemd",
              "proc",
              "frankenphp"
            ]
          },
          "name": {
            "type": "string",
            "description": "php version, unit name, or proc program name"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "site_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID"
        },
        "deployment_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID"
        },
        "commit": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "trigger": {
          "enum": [
            "push",
            "manual",
            "api",
            "rollback",
            "schedule"
          ]
        },
        "php_binary": {
          "type": "string",
          "description": "e.g. /usr/bin/php8.4 or 'frankenphp php-cli'"
        }
      },
      "description": "Deployment context. Labels the deployment lifecycle OTLP log events (falak.event.type=deployment, falak.deployment.id, falak.site.id, falak.release.id, falak.deployment.phase, falak.deployment.status); in deploy.hook also exposed to scripts as FALAK_SITE_ID, FALAK_DEPLOYMENT_ID, FALAK_COMMIT, FALAK_AUTHOR, FALAK_BRANCH, FALAK_TRIGGER, FALAK_PHP_BINARY"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "to_release_id"
      ],
      "properties": {
        "changed": {
          "type": "boolean",
          "description": "true when the host state was modified"
        },
        "from_release_id": {
          "type": "string"
        },
        "to_release_id": {
          "type": "string"
        }
      }
    }
  }
}
