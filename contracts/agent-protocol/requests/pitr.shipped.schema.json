{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falak.sh/agent-protocol/requests/pitr.shipped.schema.json",
  "title": "POST /agent/v1/requests/pitr.shipped — segments uploaded; the agent deletes a spool file only once its id is acknowledged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "kind",
    "segments"
  ],
  "properties": {
    "instance": {
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "kind": {
      "enum": [
        "wal",
        "binlog"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "size_bytes",
          "sha256",
          "plaintext_bytes",
          "plaintext_sha256",
          "end_time"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-z]{26}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "the stored (encrypted) file's"
          },
          "plaintext_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "plaintext_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "description": "when falak-db spooled it (the spool file's mtime): the segment ends no later"
          }
        }
      }
    }
  },
  "$defs": {
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledged"
      ],
      "properties": {
        "acknowledged": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-z]{26}$"
          }
        }
      }
    }
  }
}
