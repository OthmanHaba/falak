{
  "acme_email": "ops@example.com",
  "sites": [
    {
      "id": "shop",
      "domains": ["shop.example.com"],
      "redirect_domains": ["www.shop.example.com"],
      "tls": { "mode": "acme" },
      "kind": "frankenphp",
      "root": "/srv/falak/sites/shop/current/public",
      "headers": { "X-Frame-Options": "SAMEORIGIN" },
      "max_body_bytes": 104857600
    },
    {
      "id": "api",
      "domains": ["api.example.com"],
      "kind": "reverse_proxy",
      "upstreams": [{ "dial": "127.0.0.1:3000" }],
      "lb_policy": "round_robin",
      "health_uri": "/health",
      "deny_ips": ["203.0.113.0/24"],
      "mounts": [
        {
          "path_prefix": "/api",
          "strip_prefix": true,
          "dial": "127.0.0.1:7070",
          "request_headers": { "X-Falak-Function": "api", "X-Falak-Client-IP": "{http.vars.client_ip}" }
        },
        {
          "path_prefix": "/hooks",
          "dial": "hooks.example.com:443",
          "tls_server_name": "hooks.example.com",
          "request_headers": { "Host": "hooks.example.com" }
        }
      ]
    },
    {
      "id": "legacy",
      "domains": ["legacy.example.com"],
      "tls": { "mode": "custom", "cert_name": "legacy" },
      "kind": "php_fpm",
      "root": "/srv/falak/sites/legacy/current/public",
      "php_fpm_socket": "/run/php/falak-legacy-8.3.sock",
      "basic_auth": [{ "username": "staging", "password_hash": "$2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG" }],
      "redirects": [{ "from": "/old", "to": "/new", "status": 301 }]
    },
    {
      "id": "octane",
      "domains": ["octane.example.com"],
      "kind": "reverse_proxy",
      "root": "/srv/falak/sites/octane/current/public",
      "upstreams": [{ "dial": "127.0.0.1:8123" }],
      "try_duration_s": 30
    }
  ]
}
