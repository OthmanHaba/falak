{
  "site": "shop",
  "sites_root": "/srv/falak/sites",
  "release_id": "01J9Z8Y7X6W5V4T3S2R1Q0P9N1",
  "env_file": {
    "content": "APP_ENV=production\nAPP_KEY=base64:secret\nAPP_CONFIG_CACHE=.falak-cache/config.php\n"
  },
  "config_cache": true,
  "owner": {
    "user": "shop"
  },
  "after": {
    "script": "php8.4 artisan config:cache",
    "user": "shop"
  },
  "reload": [
    {
      "kind": "php_fpm",
      "name": "8.4"
    },
    {
      "kind": "site_procs",
      "name": "shop"
    }
  ],
  "mask": [
    "APP_KEY"
  ]
}
