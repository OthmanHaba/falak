{
  "name": "shop-redis",
  "image": "redis:7-alpine",
  "pull": "missing",
  "env": {
    "REDIS_ARGS": "--appendonly yes"
  },
  "command": [
    "redis-server",
    "--save",
    "60",
    "1"
  ],
  "ports": [
    {
      "host_ip": "127.0.0.1",
      "host_port": 6379,
      "container_port": 6379,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "source": "/srv/falak/data/redis",
      "target": "/data",
      "read_only": false
    }
  ],
  "network": "bridge",
  "labels": {
    "falak.site": "shop"
  },
  "restart_policy": "unless-stopped",
  "memory_bytes": 536870912,
  "cpus": 1,
  "user": "999:999",
  "secret_files": [
    {
      "name": "REDIS_PASSWORD",
      "content": "redis-secret"
    }
  ],
  "mask": [
    "REDIS_PASSWORD"
  ],
  "memory_reservation_bytes": 268435456,
  "pids_limit": 512,
  "log": {
    "max_size_mb": 20,
    "max_files": 3
  },
  "oom_score_adj": -500
}
