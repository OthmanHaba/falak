{
  "name": "shop-redis",
  "image": "redis:7-alpine",
  "pull": "missing",
  "env": {
    "REDIS_ARGS": "--appendonly yes"
  },
  "command": [
    "redis-server",
    "--save",
    "60",
    "1"
  ],
  "ports": [
    {
      "host_ip": "127.0.0.1",
      "host_port": 6379,
      "container_port": 6379,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "source": "/srv/kiln/data/redis",
      "target": "/data",
      "read_only": false
    }
  ],
  "network": "bridge",
  "labels": {
    "kiln.site": "shop"
  },
  "restart_policy": "unless-stopped",
  "memory_bytes": 268435456,
  "cpus": 0.5
}
