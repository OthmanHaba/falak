# Copy to .env and adjust. All values shown are the defaults.

# --- metrics backend -------------------------------------------------------------
# Choose ONE profile: victoriametrics (default, lighter) or mimir.
# Setting this lets you run plain `docker compose up -d` (instead of passing --profile).
# COMPOSE_PROFILES=victoriametrics
# Grafana datasource. The gateway auto-routes to whichever backend is running, so the
# default works for both. "Mimir" enables Mimir-specific features in the datasource.
KILN_METRICS_QUERY_URL=http://gateway:9090/prometheus
KILN_METRICS_PROMETHEUS_TYPE=Prometheus   # Prometheus | Mimir

# --- retention -------------------------------------------------------------------
KILN_LOGS_RETENTION=360h     # Loki   (15d)
KILN_TRACES_RETENTION=360h   # Tempo  (15d)
KILN_METRICS_RETENTION=30d   # VictoriaMetrics / Mimir

# --- ingress ---------------------------------------------------------------------
KILN_OTLP_BIND=0.0.0.0
KILN_OTLP_PORT=4318
# When set, agents must send "Authorization: Bearer <token>" to :4318/v1/*.
KILN_OTLP_TOKEN=

# --- grafana ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
KILN_GRAFANA_BIND=127.0.0.1
KILN_GRAFANA_PORT=3000

# --- loopback-only query ports (smoke test / debugging) ----------------------------
KILN_LOKI_PORT=3100
KILN_TEMPO_PORT=3200
KILN_METRICS_QUERY_PORT=9090
