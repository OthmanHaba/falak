    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU utilisation by mode",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kiln-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kiln-metrics"
          },
          "refId": "A",
          "expr": "sum by (host_name, cpu_mode) (rate(system_cpu_time_seconds_total{host_name=~\"$host\",cpu_mode!=\"idle\"}[$__rate_interval])) / on (host_name) group_left sum by (host_name) (rate(system_cpu_time_seconds_total{host_name=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host_name}} {{cpu_mode}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
