{
  "uid": "kiln-laravel",
  "title": "Kiln / Laravel site",
  "description": "Nightwatch-style APM for a Laravel site: span metrics (Tempo metrics-generator) + TraceQL + Loki.",
  "tags": [
    "kiln",
    "laravel",
    "site"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kiln-metrics"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{kiln_event_type=\"request\"}, kiln_site_id)",
          "refId": "site-var"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{kiln_event_type=\"request\"}, kiln_site_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "hide": 0
      },
      {
        "name": "slow_query_ms",
        "label": "Slow query (ms)",
        "type": "custom",
        "query": "100,250,500,1000",
        "current": {
          "text": "100",
          "value": "100"
        },
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deployments (control plane)",
        "enable": true,
        "iconColor": "#8e44ff",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "kiln",
            "deployment"
          ],
          "limit": 200,
          "matchAny": false
        }
      },
      {
        "name": "Deployments (agent logs)",
        "enable": true,
        "iconColor": "#ff9830",
        "datasource": {
          "type": "loki",
          "uid": "kiln-loki"
        },
        "expr": "{service_name=\"kiln-agent\"} | kiln_event_type=\"deployment\" | kiln_site_id=~\"${site:regex}\"",
        "titleFormat": "Deploy {{kiln_deployment_status}}",
        "textFormat": "{{kiln_deployment_id}}",
        "tagKeys": "kiln_deployment_status,kiln_site_id"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "kiln"
      ],
      "asDropdown": true,
      "title": "Kiln",
      "includeVars": true,
      "keepTime": true
    }
  ],
