{
  "uid": "falak-deployments",
  "title": "Falak / Deployments",
  "description": "Deployment timeline: Grafana annotations from the control plane + agent deployment log events.",
  "tags": [
    "falak",
    "deployments"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "falak-metrics"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{falak_event_type=\"request\"}, falak_site_id)",
          "refId": "site-var"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{falak_event_type=\"request\"}, falak_site_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deployments (control plane)",
        "enable": true,
        "iconColor": "#8e44ff",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "falak",
            "deployment"
          ],
          "limit": 200,
          "matchAny": false
        }
      },
      {
        "name": "Deployments (agent logs)",
        "enable": true,
        "iconColor": "#ff9830",
        "datasource": {
          "type": "loki",
          "uid": "falak-loki"
        },
        "expr": "{service_name=\"falak-agent\"} | falak_event_type=\"deployment\" | falak_site_id=~\"${site:regex}\"",
        "titleFormat": "Deploy {{falak_deployment_status}}",
        "textFormat": "{{falak_deployment_id}}",
        "tagKeys": "falak_deployment_status,falak_site_id"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "falak"
      ],
      "asDropdown": true,
      "title": "Falak",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deployments (range)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "falak-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "falak-loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"falak-agent\"} | falak_event_type=\"deployment\" | falak_site_id=~\"${site:regex}\" | falak_deployment_status=\"started\" [$__range]))",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed (range)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "falak-loki"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "falak-loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"falak-agent\"} | falak_event_type=\"deployment\" | falak_site_id=~\"${site:regex}\" | falak_deployment_status=\"failed\" [$__range]))",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rolled back (range)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "falak-loki"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "falak-loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"falak-agent\"} | falak_event_type=\"deployment\" | falak_site_id=~\"${site:regex}\" | falak_deployment_status=\"rolled_back\" [$__range]))",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Deployment events by status",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "falak-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "falak-loki"
          },
          "refId": "A",
          "expr": "sum by (falak_deployment_status) (count_over_time({service_name=\"falak-agent\"} | falak_event_type=\"deployment\" | falak_site_id=~\"${site:regex}\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{falak_deployment_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate around deployments",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum by (falak_site_id) (rate(traces_spanmetrics_calls_total{falak_site_id=~\"$site\",falak_event_type=\"request\"}[$__rate_interval]))",
          "legendFormat": "{{falak_site_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx ratio around deployments",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum by (falak_site_id) (rate(traces_spanmetrics_calls_total{falak_site_id=~\"$site\",falak_event_type=\"request\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (falak_site_id) (rate(traces_spanmetrics_calls_total{falak_site_id=~\"$site\",falak_event_type=\"request\"}[$__rate_interval]))",
          "legendFormat": "{{falak_site_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 latency around deployments",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, falak_site_id) (rate(traces_spanmetrics_latency_bucket{falak_site_id=~\"$site\",falak_event_type=\"request\"}[$__rate_interval])))",
          "legendFormat": "{{falak_site_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "annolist",
      "title": "Deployment annotations",
      "description": "",
      "datasource": {
        "type": "grafana",
        "uid": "-- Grafana --"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
