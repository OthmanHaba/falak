      },
      "options": {
        "onlyFromThisDashboard": false,
        "onlyInTimeRange": true,
        "tags": [
          "deployment"
        ],
        "limit": 20,
        "showUser": true,
        "showTime": true,
        "showTags": true,
        "navigateToPanel": false
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Deployment log",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "falak-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
