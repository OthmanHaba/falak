{
  "uid": "falak-containers",
  "title": "Falak / Containers",
  "description": "Docker container metrics and logs collected by falak-agent.",
  "tags": [
    "falak",
    "containers"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "falak-metrics"
        },
        "query": {
          "query": "label_values(container_memory_usage_bytes, host_name)",
          "refId": "host-var"
        },
        "definition": "label_values(container_memory_usage_bytes, host_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "hide": 0
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "falak-metrics"
        },
        "query": {
          "query": "label_values(container_memory_usage_bytes{host_name=~\"$host\"}, container_name)",
          "refId": "container-var"
        },
        "definition": "label_values(container_memory_usage_bytes{host_name=~\"$host\"}, container_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deployments (control plane)",
        "enable": true,
        "iconColor": "#8e44ff",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "falak",
            "deployment"
          ],
          "limit": 200,
          "matchAny": false
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "falak"
      ],
      "asDropdown": true,
      "title": "Falak",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running containers",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "count(count by (host_name, container_name) (container_memory_usage_bytes{host_name=~\"$host\", container_name=~\"$container\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total container memory",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum(container_memory_usage_bytes{host_name=~\"$host\", container_name=~\"$container\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total container CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum(container_cpu_utilization_ratio{host_name=~\"$host\", container_name=~\"$container\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU by container",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "max by (host_name, container_name) (container_cpu_utilization_ratio{host_name=~\"$host\", container_name=~\"$container\"})",
          "legendFormat": "{{host_name}}/{{container_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory by container",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "max by (host_name, container_name) (container_memory_usage_bytes{host_name=~\"$host\", container_name=~\"$container\"})",
          "legendFormat": "{{host_name}}/{{container_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory vs limit",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "max by (host_name, container_name) (container_memory_usage_bytes{host_name=~\"$host\", container_name=~\"$container\"}) / max by (host_name, container_name) (container_memory_limit_bytes{host_name=~\"$host\", container_name=~\"$container\"} > 0)",
          "legendFormat": "{{host_name}}/{{container_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network I/O by container",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "falak-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "falak-metrics"
          },
          "refId": "A",
          "expr": "sum by (host_name, container_name, network_io_direction) (rate(container_network_io_bytes_total{host_name=~\"$host\", container_name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "{{container_name}} {{network_io_direction}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Container logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "falak-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "falak-loki"
          },
          "refId": "A",
          "expr": "{host_name=~\"${host:regex}\"} | container_name=~\"${container:regex}\"",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
