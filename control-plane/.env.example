APP_NAME=Falak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Realtime (Reverb) -------------------------------------------------------
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Falak: agents (Fleet) ----------------------------------------------------
# Public URL agents/installers use (defaults to APP_URL) and the mTLS API base (defaults to <panel>/agent/v1).
# FALAK_PANEL_URL=
# FALAK_AGENT_API_URL=
FALAK_OTLP_ENDPOINT=http://localhost:4318
# Internal CA certificate is written to $FALAK_CA_PATH/ca.pem (default storage/falak/ca).
# FALAK_CA_PATH=
# Reverse proxies in front of the panel (comma-separated IPs/CIDRs, or *): X-Forwarded-Proto/Host/For.
TRUSTED_PROXIES=
# Proxies (CIDRs) allowed to forward X-Falak-Client-Cert-Fingerprint.
FALAK_AGENT_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Long-poll wake-up: database | redis
FALAK_AGENT_WAKE_DRIVER=database
# falak-agent binaries: served from FALAK_AGENT_BINARIES_PATH/falak-agent-linux-{amd64,arm64} unless a URL template is set.
# FALAK_AGENT_DOWNLOAD_URL=
# FALAK_AGENT_BINARIES_PATH=
FALAK_AGENT_SHA256_AMD64=
FALAK_AGENT_SHA256_ARM64=
# Build modes of the control-plane host builder (add docker only if it can reach a Docker daemon).
FALAK_LOCAL_BUILDER_MODES=native
# Shared protocol schemas (contracts/agent-protocol).
# FALAK_AGENT_SCHEMAS_PATH=
