# FrankenPHP inside the control-plane image: plain HTTP on :8080 behind the Kiln edge (deploy/edge).
# TLS, security headers and agent mTLS are the edge's job.
#
# The entrypoint (deploy/control-plane/entrypoint.sh) sizes the PHP thread pool per role and picks the PHP
# mode; see docs/INSTALL.md ("Performance"):
#   KILN_FRANKENPHP_THREADS   num_threads / max_threads lines (web: panel, agent-api: agents + builders)
#   KILN_PHP_SERVER           worker (panel, FrankenPHP worker via Laravel Octane) | classic (one boot per request)
#   KILN_PHP_WORKERS          worker threads kept booted (worker mode)
# FRANKENPHP_CONFIG (custom.env) is still appended for extra directives; if it sets num_threads/max_threads
# (the 0.2.x hotfix) the entrypoint leaves thread sizing to it.
{
	admin localhost:2019
	auto_https off
	skip_install_trust
	servers {
		# Real client IP / scheme come from the edge (Laravel TRUSTED_PROXIES handles X-Forwarded-*).
		trusted_proxies static private_ranges
	}
	frankenphp {
		{$KILN_FRANKENPHP_THREADS}
		{$FRANKENPHP_CONFIG}
	}
	log {
		format json
		level {$KILN_HTTP_LOG_LEVEL:WARN}
	}
}

:8080 {
	root /app/public
	encode zstd br gzip

	# Vite assets are content-hashed.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	import /etc/frankenphp/php-{$KILN_PHP_SERVER:classic}.caddyfile
}
