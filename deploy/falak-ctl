#!/usr/bin/env bash
# falak-ctl — operate a Falak install (Docker Compose stack in /opt/falak, created by install.sh).
#
#   falak-ctl status                        containers, health, version, URLs, PHP thread usage
#   falak-ctl logs [service] [-f]           recent logs (all services, or one)
#   falak-ctl up | down | restart [svc]     start / stop / restart the stack
#   falak-ctl update [--version vX.Y.Z]     backup -> pull -> migrate -> restart -> health check,
#                                           automatic rollback (previous version + DB restore) on failure,
#                                           then removes Falak images older than the previous version
#   falak-ctl prune-images [--dry-run]      remove Falak images except the current and previous version
#   falak-ctl backup [--label NAME]         Postgres dump + app storage + Fleet CA + .env -> backups/
#   falak-ctl restore <file> [--yes]        restore a backup (stops the app while restoring)
#   falak-ctl doctor                        DNS, certificates, ports, disk, containers, agent API, PHP threads
#   falak-ctl domain set <domain> [--keep-old]  move the panel to a new domain
#   falak-ctl registry status | prune [--dry-run] | gc [--dry-run] [--force]
#                                           built-in image registry: address and size / delete unneeded images /
#                                           garbage-collect (weekly from /etc/cron.d/falak-registry-gc)
#   falak-ctl admin reset-password <email> [--password=...]
#   falak-ctl admin create <email>
#   falak-ctl artisan <args...>             run php artisan in the control-plane container
#   falak-ctl compose <args...>             raw docker compose with the install's settings
#   falak-ctl reload-configs                recreate services whose mounted config files changed on disk
#   falak-ctl version
#
# Environment: FALAK_DIR (default /opt/falak), FALAK_PROJECT (compose project, default falak).
# Settings are read from $FALAK_DIR/.env (see docs/INSTALL.md).
set -euo pipefail

FALAK_DIR="${FALAK_DIR:-/opt/falak}"
FALAK_PROJECT="${FALAK_PROJECT:-falak}"
ENV_FILE="$FALAK_DIR/.env"
COMPOSE_FILE="$FALAK_DIR/deploy/compose.yml"
BACKUP_DIR="$FALAK_DIR/backups"
APP_SERVICES="control-plane agent-api horizon reverb scheduler builder"
FALAK_REPO_DEFAULT="OthmanHaba/falak"
TMP_LIST=""
# shellcheck disable=SC2086  # mktemp paths, space-separated
cleanup() { [ -z "$TMP_LIST" ] || rm -rf $TMP_LIST; }
trap cleanup EXIT
tmpdir() { local d; d="$(mktemp -d "${1:-${TMPDIR:-/tmp}}/.falak.XXXXXX")"; TMP_LIST="$TMP_LIST $d"; echo "$d"; }

# --- output -----------------------------------------------------------------------------------------
if [ -t 1 ]; then B=$'\e[1m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; N=$'\e[0m'; else B=; R=; G=; Y=; N=; fi
say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*" >&2; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# --- .env helpers -----------------------------------------------------------------------------------
env_get() { # env_get KEY [default]
  local v
  v="$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  v="${v%\"}"; v="${v#\"}"
  printf '%s' "${v:-${2:-}}"
}

env_set() { # env_set KEY VALUE  (atomic, keeps mode 600)
  local tmp
  tmp="$(mktemp "$FALAK_DIR/.env.XXXXXX")"
  chmod 600 "$tmp"
  if grep -qE "^$1=" "$ENV_FILE" 2>/dev/null; then
    awk -v k="$1" -v v="$2" 'BEGIN { FS = OFS = "=" } $1 == k { print k "=" v; next } { print }' "$ENV_FILE" > "$tmp"
  else
    { cat "$ENV_FILE" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } > "$tmp"
  fi
  mv "$tmp" "$ENV_FILE"
}

require_install() {
  [ -f "$ENV_FILE" ] || die "no Falak install at $FALAK_DIR (missing .env). Run install.sh first, or set FALAK_DIR."
  [ -f "$COMPOSE_FILE" ] || die "missing $COMPOSE_FILE"
  command -v docker >/dev/null || die "docker is not installed"
}

compose() {
  COMPOSE_PROFILES="$(env_get COMPOSE_PROFILES)" \
    docker compose -p "$FALAK_PROJECT" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

running_services() { compose ps --services --status running 2>/dev/null || true; }

is_running() { running_services | grep -qx "$1"; }

# Utility container for volume access: the postgres image is always present locally.
util_image() { echo "postgres:17.11"; }
volume() { echo "${FALAK_PROJECT}_$1"; }

https_port() { env_get FALAK_HTTPS_PORT 443; }

rand_hex() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }

# curl through the local edge, resolving the public names to 127.0.0.1 (works before DNS, avoids hairpin).
edge_curl() { # edge_curl HOST PATH [curl args...]
  local host="$1" path="$2"; shift 2
  local port; port="$(https_port)"
  local tls=()
  [ "$(env_get FALAK_TLS acme)" = "internal" ] && tls=(-k)
  curl -sS --max-time 15 "${tls[@]}" --resolve "$host:$port:127.0.0.1" "$@" "https://$host:$port$path"
}

# --- built-in image registry ------------------------------------------------------------------------
# Docker builds push to registry.<domain> and servers pull from it (basic auth at the edge). Installs that
# predate it get its settings here, from every command that (re)starts the stack.
ensure_registry_env() {
  local domain host port suffix
  domain="$(env_get FALAK_DOMAIN)"
  [ -n "$domain" ] || return 0
  host="$(env_get FALAK_REGISTRY_HOST)"
  if [ -z "$host" ]; then
    host="registry.$domain"
    port="$(https_port)"; suffix=""; [ "$port" != 443 ] && suffix=":$port"
    env_set FALAK_REGISTRY_HOST "$host"
    env_set FALAK_REGISTRY_URL "$host$suffix"
    info "built-in image registry: https://$host$suffix"
    say "  Add a DNS record for $host pointing at this host (like $(env_get FALAK_AGENT_API_HOST)); docker builds push there."
  fi
  [ -n "$(env_get FALAK_REGISTRY_USERNAME)" ] || env_set FALAK_REGISTRY_USERNAME falak
  [ -n "$(env_get FALAK_REGISTRY_PASSWORD)" ] || env_set FALAK_REGISTRY_PASSWORD "$(rand_hex 24)"
  ensure_registry_gc_schedule
  return 0
}

# The control plane deletes unneeded images daily (falak:registry-prune); their layers only free disk space once the
# registry garbage-collects, which needs it stopped for a moment: weekly, Sunday night, from cron.
# FALAK_REGISTRY_GC=0 turns it off (the file is removed).
ensure_registry_gc_schedule() {
  local dir="${FALAK_CRON_DIR:-/etc/cron.d}" file ctl line
  file="$dir/falak-registry-gc"
  if [ "$(env_get FALAK_REGISTRY_GC)" = 0 ]; then
    [ -f "$file" ] && rm -f "$file" && info "weekly registry garbage collection turned off"
    return 0
  fi
  [ -d "$dir" ] && [ -w "$dir" ] || return 0
  ctl="$(command -v falak-ctl 2>/dev/null || echo /usr/local/bin/falak-ctl)"
  line="17 4 * * 0 root FALAK_DIR=$FALAK_DIR $ctl registry gc >> /var/log/falak-registry-gc.log 2>&1"
  if [ "$(grep -v '^#' "$file" 2>/dev/null)" != "$line" ]; then
    printf '# Falak: weekly garbage collection of the built-in image registry (falak-ctl registry gc).\n%s\n' "$line" > "$file"
    chmod 644 "$file"
  fi
}

curl_config_quote() { # curl_config_quote VALUE -> "VALUE" for a curl config file (\ and " escaped)
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  printf '"%s"' "$v"
}

registry_code() { # registry_code [--auth] -> HTTP status of GET /v2/ through the edge
  local host
  host="$(env_get FALAK_REGISTRY_HOST)"
  [ -n "$host" ] || { echo none; return 0; }
  if [ "${1:-}" = --auth ]; then
    # Credentials via a curl config on stdin, never on the command line.
    printf 'user = %s\n' "$(curl_config_quote "$(env_get FALAK_REGISTRY_USERNAME):$(env_get FALAK_REGISTRY_PASSWORD)")" \
      | edge_curl "$host" /v2/ -o /dev/null -w '%{http_code}' -K - 2>/dev/null || true
    return 0
  fi
  edge_curl "$host" /v2/ -o /dev/null -w '%{http_code}' 2>/dev/null || true
}

cmd_registry() {
  require_install
  local sub="${1:-status}"; shift || true
  case "$sub" in
    status)
      ensure_registry_env
      say "  address: https://$(env_get FALAK_REGISTRY_URL)  (user $(env_get FALAK_REGISTRY_USERNAME); password: FALAK_REGISTRY_PASSWORD in $ENV_FILE)"
      if is_running registry; then
        ok "registry running, $(compose exec -T registry du -sh /var/lib/registry 2>/dev/null | cut -f1 || echo '?') stored"
      else bad "registry is not running (falak-ctl up)"; fi
      local code; code="$(registry_code --auth)"
      if [ "$code" = 200 ]; then ok "https://$(env_get FALAK_REGISTRY_HOST)/v2/ answers with the credentials (200)"
      else bad "https://$(env_get FALAK_REGISTRY_HOST)/v2/ with the credentials -> ${code:-no response}"; fi
      ;;
    gc)
      # Removes layers and untagged manifests nothing references. The registry is stopped meanwhile: a push
      # during garbage collection could lose layers, so it is skipped while an image build is queued or running
      # (the control plane's falak:registry-idle exits 1; the weekly cron run tries again next week). --force skips
      # the check.
      local dry="" force="" status=0 arg idle
      for arg in "$@"; do
        case "$arg" in
          --dry-run) dry="--dry-run" ;;
          --force) force=1 ;;
          *) die "usage: falak-ctl registry gc [--dry-run] [--force]" ;;
        esac
      done
      is_running registry || die "registry is not running"
      if [ -z "$force" ]; then
        if ! idle="$(compose exec -T control-plane php artisan falak:registry-idle 2>&1)"; then
          warn "$(date '+%Y-%m-%d %H:%M') skipping registry garbage collection: ${idle##*$'\n'}" \
            "(tried again next week; falak-ctl registry gc --force runs it anyway)"
          return 0
        fi
      fi
      info "garbage-collecting the built-in registry${dry:+ (dry run)}"
      # A subshell whose EXIT trap, installed before the stop, starts the registry again however it ends (failure,
      # Ctrl-C, kill). set -e does not apply inside `( ) || …`, hence the explicit exits.
      (
        trap 'trap - EXIT; compose start registry >/dev/null || { bad "the registry did not start again (falak-ctl up)"; exit 1; }' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        compose stop registry >/dev/null || exit 1
        # shellcheck disable=SC2086  # optional flag
        if compose run --rm --no-deps -T registry garbage-collect --delete-untagged $dry /etc/docker/registry/config.yml \
          | grep -Ev ': marking (blob|manifest) ' | tail -3; then
          ok "garbage collection done"
        else warn "garbage collection failed (falak-ctl logs registry)"; exit 1; fi
      ) || status=$?
      return "$status"
      ;;
    prune)
      # Deletes images no build or release needs (the control plane also runs this daily); gc frees the space.
      local args=()
      [ "${1:-}" = --dry-run ] && args=(--dry-run)
      compose exec -T control-plane php artisan falak:registry-prune "${args[@]}"
      ;;
    *) die "usage: falak-ctl registry status | prune [--dry-run] | gc [--dry-run] [--force]" ;;
  esac
}

# --- health -----------------------------------------------------------------------------------------
health_check() { # quiet health check used by update/restore; prints problems
  local failed=0 svc state health
  while read -r svc state health; do
    [ -n "$svc" ] || continue
    if [ "$state" != "running" ]; then bad "$svc is $state"; failed=1
    elif [ -n "$health" ] && [ "$health" != "healthy" ]; then bad "$svc is $health"; failed=1
    fi
  done < <(compose ps -a --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null)
  local code
  code="$(edge_curl "$(env_get FALAK_DOMAIN)" /up -o /dev/null -w '%{http_code}' 2>/dev/null || true)"
  if [ "$code" = "200" ]; then ok "panel $(env_get FALAK_URL)/up -> 200"; else bad "panel $(env_get FALAK_URL)/up -> ${code:-no response}"; failed=1; fi
  return "$failed"
}

# --- PHP threads (FrankenPHP admin API inside the container) -------------------------------------------
# The panel (control-plane) and the agent API (agent-api) each have their own PHP thread pool. A request that
# finds every thread busy waits in a queue, so a saturated pool shows up as slow pages / late heartbeats.
PHP_POOLS="control-plane agent-api"

pool_label() { case "$1" in control-plane) echo panel ;; *) echo "$1" ;; esac; }

pool_knob() { case "$1" in agent-api) echo FALAK_AGENT_API_THREADS ;; *) echo FALAK_PHP_MAX_THREADS ;; esac; }

php_threads() { # php_threads SERVICE -> "BUSY CAPACITY" (capacity = started + reserved for autoscaling)
  # shellcheck disable=SC2016  # PHP code
  compose exec -T "$1" php -r '
    $j = json_decode((string) @file_get_contents("http://localhost:2019/frankenphp/threads"), true);
    if (! is_array($j)) { exit(1); }
    $t = $j["ThreadDebugStates"] ?? [];
    echo count(array_filter($t, fn ($x) => (bool) ($x["IsBusy"] ?? false))), " ", count($t) + (int) ($j["ReservedThreadCount"] ?? 0), "\n";
  ' 2>/dev/null
}

legacy_thread_config() { # the 0.2.x hotfix line in custom.env, if present
  grep -E '^[[:space:]]*FRANKENPHP_CONFIG=.*(num|max)_threads' "$FALAK_DIR/custom.env" 2>/dev/null | tail -1 || true
}

wait_healthy() { # wait_healthy [timeout]
  local timeout="${1:-300}"
  compose up -d --wait --wait-timeout "$timeout" --remove-orphans
  recreate_drifted "$timeout"
}

# --- bind-mounted config files --------------------------------------------------------------------------
# compose.yml bind-mounts config files and directories from deploy/ and observability/ (loki.yaml, tempo.yaml,
# the gateway Caddyfile, Grafana provisioning). An update swaps those directories, and a running container keeps
# the files it was started with: the mount pins the old inode. `compose up` does not recreate a service whose
# compose definition is unchanged, so without this Loki kept running the previous loki.yaml. Compare what each
# running container sees (docker cp reads through its mounts) with the files on disk and force-recreate exactly
# the services that differ. This also repairs containers left stale by older falak-ctl versions.
mount_matches() { # mount_matches CONTAINER HOST_PATH CONTAINER_PATH -> 0 when the container sees the host content
  local pid tmp rc=1
  # Linux: read through the container's own mount namespace. `docker cp` re-resolves bind mounts from the host
  # path there, so it would show the new file even while the container still sees the replaced inode.
  pid="$(docker inspect -f '{{.State.Pid}}' "$1" 2>/dev/null || echo 0)"
  if [ "${pid:-0}" -gt 0 ] && [ -r "/proc/$pid/root/" ]; then
    diff -r "/proc/$pid/root$3" "$2" >/dev/null 2>&1
    return
  fi
  # Docker Desktop (no host /proc for the VM's processes): `docker cp` reads the container's view.
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/.falak-mount.XXXXXX")"
  if docker cp "$1:$3" - 2>/dev/null | tar -xf - -C "$tmp" 2>/dev/null \
    && diff -r "$tmp/$(basename "$3")" "$2" >/dev/null 2>&1; then
    rc=0
  fi
  rm -rf "$tmp"
  return "$rc"
}

bundle_path() { # bundle_path HOST_PATH -> 0 when it lies in the install's deploy/ or observability/
  local root
  root="$(cd "$FALAK_DIR" 2>/dev/null && pwd -P || echo "$FALAK_DIR")"
  case "$1" in
    "$FALAK_DIR"/deploy/*|"$FALAK_DIR"/observability/*|"$root"/deploy/*|"$root"/observability/*) return 0 ;;
  esac
  return 1
}

mount_drift() { # prints each running service whose mounted Falak config differs from the files on disk
  local svc id src dst
  while read -r svc id; do
    [ -n "$id" ] || continue
    while IFS='|' read -r src dst; do
      if [ -z "$src" ] || ! bundle_path "$src"; then continue; fi
      if ! mount_matches "$id" "$src" "$dst"; then echo "$svc"; break; fi
    done < <(docker inspect -f '{{range .Mounts}}{{if eq .Type "bind"}}{{.Source}}|{{.Destination}}{{"\n"}}{{end}}{{end}}' "$id" 2>/dev/null || true)
  done < <(compose ps --format '{{.Service}} {{.ID}}' 2>/dev/null || true)
}

recreate_drifted() { # recreate_drifted [timeout] : force-recreate services whose mounted config files changed
  local drifted
  drifted="$(mount_drift | sort -u | tr '\n' ' ')"
  drifted="${drifted% }"
  [ -n "$drifted" ] || return 0
  info "mounted config files changed: recreating $drifted"
  # shellcheck disable=SC2086  # service names, space-separated
  compose up -d --wait --wait-timeout "${1:-300}" --no-deps --force-recreate $drifted
  ok "recreated $drifted"
}

# --- deploy bundle (compose.yml, edge/control-plane files, observability configs) ---------------------
# Source: FALAK_DEPLOY_SOURCE (local checkout dir), or the GitHub release asset falak-deploy.tar.gz.
fetch_bundle() { # fetch_bundle VERSION DEST_DIR
  local version="$1" dest="$2" src repo tmp
  src="$(env_get FALAK_DEPLOY_SOURCE)"
  rm -rf "$dest"; mkdir -p "$dest"
  if [ -n "$src" ]; then
    [ -d "$src/deploy" ] || die "FALAK_DEPLOY_SOURCE=$src has no deploy/ directory"
    cp -R "$src/deploy" "$dest/deploy"
    cp -R "$src/observability" "$dest/observability"
    return 0
  fi
  repo="$(env_get FALAK_REPO "$FALAK_REPO_DEFAULT")"
  tmp="$(tmpdir)"
  curl -fsSL --retry 3 -o "$tmp/falak-deploy.tar.gz" "https://github.com/$repo/releases/download/$version/falak-deploy.tar.gz" \
    || { rm -rf "$tmp"; die "could not download falak-deploy.tar.gz for $version from github.com/$repo"; }
  if curl -fsSL --retry 3 -o "$tmp/SHA256SUMS" "https://github.com/$repo/releases/download/$version/SHA256SUMS" 2>/dev/null; then
    (cd "$tmp" && grep ' falak-deploy.tar.gz$' SHA256SUMS | sha256sum -c --quiet -) || { rm -rf "$tmp"; die "checksum mismatch for falak-deploy.tar.gz"; }
  fi
  tar -xzf "$tmp/falak-deploy.tar.gz" -C "$dest"
  rm -rf "$tmp"
}

latest_version() {
  local repo
  repo="$(env_get FALAK_REPO "$FALAK_REPO_DEFAULT")"
  curl -fsSL "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
    | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1
}

install_bundle() { # install_bundle STAGED_DIR : swap deploy/ + observability/ into place, keep *.prev
  local staged="$1" d
  for d in deploy observability; do
    rm -rf "$FALAK_DIR/$d.prev"
    [ -d "$FALAK_DIR/$d" ] && mv "$FALAK_DIR/$d" "$FALAK_DIR/$d.prev"
    mv "$staged/$d" "$FALAK_DIR/$d"
  done
  if [ -f "$FALAK_DIR/deploy/falak-ctl" ] && [ -w /usr/local/bin ] && [ "$(id -u)" = 0 ]; then
    install -m 0755 "$FALAK_DIR/deploy/falak-ctl" /usr/local/bin/falak-ctl
  fi
}

restore_prev_bundle() {
  local d
  for d in deploy observability; do
    if [ -d "$FALAK_DIR/$d.prev" ]; then rm -rf "${FALAK_DIR:?}/$d"; mv "$FALAK_DIR/$d.prev" "$FALAK_DIR/$d"; fi
  done
}

# pull_retry CMD... : run an image pull, retrying transient registry errors ("connection reset by peer", IPv6
# resets, 5xx) with backoff: FALAK_PULL_ATTEMPTS tries (default 4), waiting 5s, 10s, 20s ... in between.
pull_retry() {
  local attempt=1 max delay
  max="$(env_get FALAK_PULL_ATTEMPTS "${FALAK_PULL_ATTEMPTS:-4}")"; delay="${FALAK_PULL_DELAY:-5}"
  until "$@"; do
    if [ "$attempt" -ge "$max" ]; then
      bad "image pull failed $attempt times, giving up"
      return 1
    fi
    warn "image pull failed (attempt $attempt of $max, usually a transient registry or network error); retrying in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1)); delay=$((delay * 2))
  done
}

pull_images() { # pull_images [missing] : all images (update), or only the ones not present yet (up)
  if [ "$(env_get FALAK_PULL 1)" = "0" ]; then
    info "FALAK_PULL=0: using local images"
    return 0
  fi
  if [ "${1:-}" = missing ]; then
    pull_retry compose pull --quiet --policy missing
  else
    pull_retry compose pull --quiet
  fi
}

# The images this install pulls or builds itself (never third-party images such as postgres or grafana).
falak_image_repos() {
  local prefix
  prefix="$(env_get FALAK_IMAGE_PREFIX)"
  [ -n "$prefix" ] || return 0
  printf '%s\n' "$prefix/falak-control-plane" "$prefix/falak-edge" "$prefix/falak-builder"
}

# prune_images [--dry-run]: remove Falak images other than FALAK_VERSION and FALAK_PREVIOUS_VERSION (the rollback
# target). Images still used by a container are left alone (no --force); volumes are never touched.
prune_images() {
  local dry=0 current previous repo tag id ref removed=0 kept=0
  [ "${1:-}" = "--dry-run" ] && dry=1
  current="$(env_get FALAK_VERSION)"
  previous="$(env_get FALAK_PREVIOUS_VERSION)"
  [ -n "$current" ] || { warn "FALAK_VERSION is not set; not pruning images"; return 0; }
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    while read -r tag id; do
      [ -n "$id" ] || continue
      if [ "$tag" = "$current" ] || { [ -n "$previous" ] && [ "$tag" = "$previous" ]; }; then
        kept=$((kept + 1)); continue
      fi
      if [ "$tag" = "<none>" ]; then ref="$id"; else ref="$repo:$tag"; fi
      if [ "$dry" = 1 ]; then
        say "  would remove $ref"; removed=$((removed + 1))
      elif docker image rm "$ref" >/dev/null 2>&1; then
        say "  removed $ref"; removed=$((removed + 1))
      else
        warn "kept $ref (in use or referenced elsewhere)"
      fi
    done < <(docker image ls --format '{{.Tag}} {{.ID}}' "$repo" 2>/dev/null || true)
  done < <(falak_image_repos)
  if [ "$dry" = 1 ]; then ok "$removed old Falak image(s) would be removed, $kept kept"
  else ok "$removed old Falak image(s) removed, $kept kept (${current}${previous:+, $previous})"; fi
}

# after_update_images PREV TARGET: keep exactly one rollback target, then prune. FALAK_PRUNE_IMAGES=0 keeps every image;
# FALAK_PULL=0 runs locally built images that cannot be pulled again, so they are never removed automatically.
after_update_images() {
  [ "$1" = "$2" ] || env_set FALAK_PREVIOUS_VERSION "$1"
  if [ "$(env_get FALAK_PULL 1)" = "0" ]; then
    say "  FALAK_PULL=0: keeping old images (falak-ctl prune-images removes them)"
  elif [ "$(env_get FALAK_PRUNE_IMAGES 1)" != "0" ]; then
    prune_images || warn "could not prune old images"
  fi
}

cmd_prune_images() {
  require_install
  case "${1:-}" in
    ""|--dry-run)
      [ "$(env_get FALAK_PULL 1)" != "0" ] || warn "FALAK_PULL=0: removed images were built locally and cannot be pulled again"
      prune_images "$@" ;;
    *) die "usage: falak-ctl prune-images [--dry-run]" ;;
  esac
}

# --- commands -----------------------------------------------------------------------------------------
cmd_status() {
  require_install
  info "Falak $(env_get FALAK_VERSION) at $FALAK_DIR (project $FALAK_PROJECT)"
  compose ps --format 'table {{.Service}}\t{{.Status}}\t{{.Image}}'
  say
  say "  panel:      $(env_get FALAK_URL)"
  say "  agent API:  $(env_get FALAK_AGENT_API_URL)"
  if [ -n "$(env_get FALAK_GRAFANA_HOST)" ]; then say "  grafana:    $(env_get FALAK_GRAFANA_PUBLIC_URL)"; fi
  local svc usage threads=""
  for svc in $PHP_POOLS; do
    usage="$(php_threads "$svc" || true)"
    [ -n "$usage" ] || continue
    threads="${threads:+$threads · }$(pool_label "$svc") ${usage% *}/${usage#* } busy"
  done
  say "  PHP threads: ${threads:-unavailable}"
  local last
  last="$(latest_backup)"
  say "  last backup: ${last:-none}"
}

cmd_logs() {
  require_install
  local follow=() svc=()
  for a in "$@"; do
    case "$a" in -f|--follow) follow=(-f) ;; *) svc+=("$a") ;; esac
  done
  compose logs --tail="${FALAK_LOG_TAIL:-200}" "${follow[@]}" "${svc[@]}"
}

latest_backup() { # newest by name (UTC timestamps sort)
  [ -d "$BACKUP_DIR" ] || return 0
  find "$BACKUP_DIR" -maxdepth 1 -type f -name 'falak-backup-*' 2>/dev/null | sort -r | head -1 || true
}

cmd_backup() {
  require_install
  local label="" quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) label="-$2"; shift ;;
      --label=*) label="-${1#--label=}" ;;
      --quiet) quiet=1 ;;
      *) die "backup: unknown option $1" ;;
    esac
    shift
  done
  label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._\n-' '-')"
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  local ts name work out
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  name="falak-backup-$ts$label"
  work="$(tmpdir "$BACKUP_DIR")"
  [ "$quiet" = 1 ] || info "backup $name"

  is_running postgres || compose up -d --wait postgres >/dev/null
  compose exec -T postgres pg_dump -U falak -d falak -Fc --no-owner > "$work/db.dump" \
    || die "pg_dump failed"
  [ -s "$work/db.dump" ] || die "pg_dump produced an empty dump"
  [ "$quiet" = 1 ] || ok "database ($(du -h "$work/db.dump" | cut -f1))"

  local vol
  for vol in falak-ca app-storage caddy-data; do
    docker run --rm -v "$(volume "$vol"):/data:ro" "$(util_image)" tar -C /data -czf - . > "$work/$vol.tar.gz" \
      || die "could not archive volume $vol"
  done
  # The Fleet CA key is in the database (encrypted with APP_KEY); ca.pem + agent-api cert are in falak-ca.
  tar -tzf "$work/falak-ca.tar.gz" 2>/dev/null | grep -q 'ca.pem' || warn "Fleet CA certificate not found in the falak-ca volume (no agents enrolled yet?)"
  [ "$quiet" = 1 ] || ok "volumes: falak-ca (Fleet CA), app-storage, caddy-data"

  cp "$ENV_FILE" "$work/env"
  [ -f "$FALAK_DIR/custom.env" ] && cp "$FALAK_DIR/custom.env" "$work/custom.env"
  {
    echo "falak_version=$(env_get FALAK_VERSION)"
    echo "created_at=$ts"
    echo "host=$(hostname)"
    echo "domain=$(env_get FALAK_DOMAIN)"
  } > "$work/manifest"

  out="$BACKUP_DIR/$name.tar.gz"
  tar -C "$work" -czf "$out.tmp" .
  local pass
  pass="$(env_get FALAK_BACKUP_PASSPHRASE)"
  if [ -n "$pass" ]; then
    FALAK_BACKUP_PASSPHRASE="$pass" openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:FALAK_BACKUP_PASSPHRASE \
      -in "$out.tmp" -out "$out.enc.tmp" && rm -f "$out.tmp" && mv "$out.enc.tmp" "$out.enc"
    out="$out.enc"
  else
    mv "$out.tmp" "$out"
  fi
  chmod 600 "$out"
  [ "$quiet" = 1 ] || ok "wrote $out ($(du -h "$out" | cut -f1)) — contains secrets (APP_KEY, Fleet CA), keep it safe"

  s3_upload "$out"

  # retention (local)
  local keep
  keep="$(env_get FALAK_BACKUP_KEEP 14)"
  find "$BACKUP_DIR" -maxdepth 1 -type f -name 'falak-backup-*' | sort -r | tail -n +"$((keep + 1))" | while read -r old; do
    rm -f "$old"; [ "$quiet" = 1 ] || say "  pruned $(basename "$old")"
  done
  LAST_BACKUP="$out"
}

s3_upload() { # optional: FALAK_BACKUP_S3_{ENDPOINT,BUCKET,REGION,ACCESS_KEY,SECRET_KEY,PREFIX}
  local file="$1" endpoint bucket
  endpoint="$(env_get FALAK_BACKUP_S3_ENDPOINT)"; bucket="$(env_get FALAK_BACKUP_S3_BUCKET)"
  if [ -z "$endpoint" ] || [ -z "$bucket" ]; then return 0; fi
  local region prefix key url
  region="$(env_get FALAK_BACKUP_S3_REGION us-east-1)"
  prefix="$(env_get FALAK_BACKUP_S3_PREFIX falak)"
  key="${prefix:+$prefix/}$(basename "$file")"
  url="${endpoint%/}/$bucket/$key"
  if curl -fsS --retry 3 --aws-sigv4 "aws:amz:$region:s3" \
      --user "$(env_get FALAK_BACKUP_S3_ACCESS_KEY):$(env_get FALAK_BACKUP_S3_SECRET_KEY)" \
      -H "x-amz-content-sha256: UNSIGNED-PAYLOAD" -T "$file" "$url" -o /dev/null; then
    ok "uploaded to $url"
  else
    warn "S3 upload to $url failed (the local backup is kept)"
  fi
}

extract_backup() { # extract_backup FILE DIR
  local file="$1" dir="$2"
  case "$file" in
    *.enc)
      local pass; pass="$(env_get FALAK_BACKUP_PASSPHRASE "${FALAK_BACKUP_PASSPHRASE:-}")"
      [ -n "$pass" ] || die "$file is encrypted: set FALAK_BACKUP_PASSPHRASE"
      FALAK_BACKUP_PASSPHRASE="$pass" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:FALAK_BACKUP_PASSPHRASE -in "$file" \
        | tar -xzf - -C "$dir" ;;
    *) tar -xzf "$file" -C "$dir" ;;
  esac
  if [ ! -s "$dir/db.dump" ] || [ ! -f "$dir/env" ]; then die "$file is not a Falak backup (db.dump/env missing)"; fi
}

cmd_restore() {
  require_install
  local file="" yes=0 keep_env=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1 ;;
      --keep-env) keep_env=1 ;;
      -*) die "restore: unknown option $1" ;;
      *) file="$1" ;;
    esac
    shift
  done
  [ -n "$file" ] || die "usage: falak-ctl restore <backup file> [--yes] [--keep-env]"
  if [ ! -f "$file" ] && [ -f "$BACKUP_DIR/$file" ]; then file="$BACKUP_DIR/$file"; fi
  [ -f "$file" ] || die "no such file: $file"
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "restore replaces the database, storage and Fleet CA: re-run with --yes to confirm"
    printf 'Restore %s? This REPLACES the database, app storage, Fleet CA and .env. [y/N] ' "$file"
    read -r answer; [ "$answer" = y ] || [ "$answer" = Y ] || die "aborted"
  fi
  do_restore "$file" "$keep_env"
}

do_restore() { # do_restore FILE KEEP_ENV
  local file="$1" keep_env="$2" work
  work="$(tmpdir)"
  info "restoring $(basename "$file")"
  extract_backup "$file" "$work"
  sed 's/^/  /' "$work/manifest" 2>/dev/null || true

  # shellcheck disable=SC2086
  compose stop $APP_SERVICES edge >/dev/null 2>&1 || true
  if [ "$keep_env" != 1 ]; then
    local keep_version keep_source keep_pull
    keep_version="$(env_get FALAK_VERSION)"; keep_source="$(env_get FALAK_DEPLOY_SOURCE)"; keep_pull="$(env_get FALAK_PULL)"
    install -m 600 "$work/env" "$ENV_FILE"
    [ -f "$work/custom.env" ] && install -m 600 "$work/custom.env" "$FALAK_DIR/custom.env"
    # Local-only knobs of this host win over the backup's.
    [ -n "$keep_source" ] && env_set FALAK_DEPLOY_SOURCE "$keep_source"
    [ -n "$keep_pull" ] && env_set FALAK_PULL "$keep_pull"
    [ "${RESTORE_KEEP_VERSION:-1}" = 1 ] && [ -n "$keep_version" ] && env_set FALAK_VERSION "$keep_version"
    ok ".env restored (APP_KEY decrypts the Fleet CA key in the database)"
  fi

  compose up -d --wait postgres valkey >/dev/null
  # Align the role password with the (restored) .env; local socket connections are trusted in the image.
  compose exec -T postgres psql -v ON_ERROR_STOP=1 -U falak -d postgres -q \
    -c "ALTER USER falak PASSWORD '$(env_get DB_PASSWORD)';" \
    -c "DROP DATABASE IF EXISTS falak WITH (FORCE);" -c "CREATE DATABASE falak OWNER falak;" >/dev/null \
    || die "could not recreate the database"
  compose exec -T postgres pg_restore -U falak -d falak --no-owner --exit-on-error < "$work/db.dump" \
    || die "pg_restore failed"
  ok "database restored"

  local vol
  for vol in falak-ca app-storage caddy-data; do
    [ -f "$work/$vol.tar.gz" ] || continue
    docker volume create "$(volume "$vol")" >/dev/null
    docker run --rm -i -v "$(volume "$vol"):/data" "$(util_image)" \
      sh -c 'find /data -mindepth 1 -delete && tar -C /data -xzf -' < "$work/$vol.tar.gz" \
      || die "could not restore volume $vol"
  done
  ok "volumes restored: falak-ca (Fleet CA), app-storage, caddy-data"

  # valkey picks up a changed password on recreate; web runs migrations (a newer image migrates the old dump).
  wait_healthy 420 || { bad "stack did not become healthy after restore"; return 1; }
  health_check || return 1
  ok "restore complete"
}

cmd_update() {
  require_install
  local target="" skip_backup=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) target="$2"; shift ;;
      --version=*) target="${1#--version=}" ;;
      --skip-backup) skip_backup=1 ;;
      *) die "update: unknown option $1" ;;
    esac
    shift
  done
  local prev
  prev="$(env_get FALAK_VERSION)"
  if [ -z "$target" ]; then
    target="$(latest_version)"
    [ -n "$target" ] || die "could not determine the latest release (pass --version)"
  fi
  info "update $prev -> $target"

  # 1. backup (the rollback point)
  local backup=""
  if [ "$skip_backup" != 1 ]; then
    cmd_backup --label "pre-update-$prev" --quiet
    backup="$LAST_BACKUP"
    ok "backup $(basename "$backup")"
  fi

  # 2. stage the new deploy bundle, switch version, pull
  local staged
  staged="$(tmpdir)"
  fetch_bundle "$target" "$staged"
  install_bundle "$staged"; rm -rf "$staged"
  env_set FALAK_VERSION "$target"
  ensure_registry_env
  if ! pull_images; then
    bad "pulling images for $target failed; nothing was changed"
    env_set FALAK_VERSION "$prev"; restore_prev_bundle
    return 1
  fi
  ok "images for $target ready"

  # 3. restart (web migrates on start; horizon/scheduler/reverb wait for it)
  local failed=0
  if ! wait_healthy 420; then failed=1; fi
  if [ "$failed" = 0 ] && ! health_check; then failed=1; fi
  if [ "$failed" = 0 ]; then
    ok "Falak $target is up"
    after_update_images "$prev" "$target"
    agents_hint
    return 0
  fi

  # 4. rollback
  bad "update to $target failed — rolling back to $prev"
  compose logs --tail=40 control-plane 2>/dev/null | sed 's/^/    /' >&2 || true
  env_set FALAK_VERSION "$prev"
  restore_prev_bundle
  if [ -n "$backup" ]; then
    RESTORE_KEEP_VERSION=1 do_restore "$backup" 0 || die "ROLLBACK FAILED: restore $backup manually (falak-ctl restore $backup --yes)"
  else
    if ! wait_healthy 420 || ! health_check; then die "ROLLBACK FAILED: previous version $prev is not healthy"; fi
  fi
  ok "rolled back to $prev"
  return 1
}

# Servers keep their agent until it is upgraded from the panel: say so when the new release ships a newer one.
agents_hint() {
  local n
  n="$(compose exec -T control-plane php artisan falak:agents --outdated --count 2>/dev/null | tr -dc '0-9')"
  if [ -n "$n" ] && [ "$n" -gt 0 ]; then
    warn "$n server agent(s) run an older falak-agent than this release ships."
    say "  Update them in the panel (Servers → Update all agents, or Update per server) or: curl -X POST -H 'Authorization: Bearer …' https://$(env_get FALAK_DOMAIN)/api/v1/servers/<id>/agent/upgrade"
  fi
}

cmd_doctor() {
  require_install
  local domain agents grafana registry port problems=0
  domain="$(env_get FALAK_DOMAIN)"; agents="$(env_get FALAK_AGENT_API_HOST)"; grafana="$(env_get FALAK_GRAFANA_HOST)"
  registry="$(env_get FALAK_REGISTRY_HOST)"
  port="$(https_port)"

  info "DNS"
  local pub4 pub6
  pub4="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  pub6="$(curl -6 -fsS --max-time 5 https://api6.ipify.org 2>/dev/null || true)"
  say "  public IPv4: ${pub4:-unknown}   IPv6: ${pub6:-none}"
  local h addrs
  for h in "$domain" "$agents" $grafana $registry; do
    addrs="$(resolve "$h")"
    if [ -z "$addrs" ]; then bad "$h does not resolve"; problems=$((problems + 1))
    elif { [ -n "$pub4" ] && grep -qx "$pub4" <<<"$addrs"; } || { [ -n "$pub6" ] && grep -qx "$pub6" <<<"$addrs"; }; then ok "$h -> $(tr '\n' ' ' <<<"$addrs")"
    else warn "$h -> $(tr '\n' ' ' <<<"$addrs") (not this host's public IP ${pub4:-?})"; problems=$((problems + 1))
    fi
  done

  info "Ports"
  local p
  for p in "$(env_get FALAK_HTTP_PORT 80)" "$port"; do
    if port_listening "$p"; then ok "port $p listening"; else bad "nothing listens on port $p"; problems=$((problems + 1)); fi
  done

  info "Containers"
  health_check || problems=$((problems + 1))

  info "Certificates"
  local end issuer
  if end="$(cert_field "$domain" -enddate)"; then
    issuer="$(cert_field "$domain" -issuer || true)"
    ok "$domain: ${end#notAfter=} (${issuer#issuer=})"
    # Caddy's internal CA issues 12-hour certificates (FALAK_TLS=internal); ACME renews 30 days ahead.
    if [ "$(env_get FALAK_TLS acme)" = acme ] && ! days_left "${end#notAfter=}" 14; then
      warn "$domain certificate expires within 14 days (renewal failing? falak-ctl logs edge)"; problems=$((problems + 1))
    fi
  else bad "$domain: no TLS certificate served"; problems=$((problems + 1)); fi
  local ca
  ca="$(mktemp)"
  if compose exec -T control-plane cat /falak/ca/ca.pem > "$ca" 2>/dev/null && [ -s "$ca" ]; then
    ok "Fleet CA present ($(openssl x509 -in "$ca" -noout -subject 2>/dev/null | sed 's/subject=//'))"
    if echo | openssl s_client -connect "127.0.0.1:$port" -servername "$agents" -CAfile "$ca" -verify_return_error </dev/null >/dev/null 2>&1; then
      ok "$agents serves a certificate chained to the Fleet CA"
    else bad "$agents does not serve a Fleet-CA certificate"; problems=$((problems + 1)); fi
  else bad "Fleet CA ($FALAK_DIR volume falak-ca/ca.pem) missing"; problems=$((problems + 1)); fi

  info "Agent API"
  local code
  code="$(curl -sS --max-time 10 --cacert "$ca" --resolve "$agents:$port:127.0.0.1" -o /dev/null -w '%{http_code}' "https://$agents:$port/agent/v1/heartbeat" -X POST 2>/dev/null || true)"
  if [ "$code" = 401 ]; then ok "requests without a client certificate are rejected (401)"; else bad "agent API without client cert -> ${code:-no response} (expected 401)"; problems=$((problems + 1)); fi
  code="$(edge_curl "$domain" /install/agent/linux-amd64 -o /dev/null -w '%{http_code}' -r 0-0 2>/dev/null || true)"
  case "$code" in 200|206) ok "agent binaries served (/install/agent/linux-amd64)";; *) bad "agent binary download -> ${code:-no response}"; problems=$((problems + 1));; esac
  rm -f "$ca"

  info "Image registry"
  if [ -z "$registry" ]; then
    warn "no built-in registry configured (docker builds cannot push) — run falak-ctl up"; problems=$((problems + 1))
  else
    code="$(registry_code)"
    if [ "$code" = 401 ]; then ok "$registry requires credentials (401 without)"; else bad "$registry without credentials -> ${code:-no response} (expected 401)"; problems=$((problems + 1)); fi
    code="$(registry_code --auth)"
    if [ "$code" = 200 ]; then ok "$registry answers with the credentials (200)"; else bad "$registry with the credentials -> ${code:-no response} (falak-ctl logs registry / edge)"; problems=$((problems + 1)); fi
  fi

  info "PHP threads"
  local svc samples usage busy cap min_busy knob legacy
  for svc in $PHP_POOLS; do
    # Three samples a second apart; the least busy one counts (a short burst is normal, a full pool is not).
    min_busy=""; cap=""
    for samples in 1 2 3; do
      usage="$(php_threads "$svc" || true)"
      [ -n "$usage" ] || continue
      busy="${usage% *}"; cap="${usage#* }"
      if [ -z "$min_busy" ] || [ "$busy" -lt "$min_busy" ]; then min_busy="$busy"; fi
      [ "$samples" = 3 ] || sleep 1
    done
    knob="$(pool_knob "$svc")"
    if [ -z "$cap" ]; then
      bad "$(pool_label "$svc"): thread usage unavailable ($svc not running?)"; problems=$((problems + 1))
    elif [ "$min_busy" -ge "$cap" ]; then
      bad "$(pool_label "$svc"): all $cap PHP threads busy — requests are queueing. Raise $knob in $ENV_FILE, then falak-ctl up"
      problems=$((problems + 1))
    elif [ $((min_busy * 100)) -ge $((cap * 80)) ]; then
      warn "$(pool_label "$svc"): $min_busy/$cap PHP threads busy (>= 80%) — consider raising $knob"
      problems=$((problems + 1))
    else
      ok "$(pool_label "$svc"): $min_busy/$cap PHP threads busy"
    fi
  done
  legacy="$(legacy_thread_config)"
  if [ -n "$legacy" ]; then
    warn "custom.env: '$legacy' (0.2.x hotfix) overrides the automatic thread sizing — remove the line, then falak-ctl up"
    problems=$((problems + 1))
  fi

  info "Disk & memory"
  local avail
  avail="$(df -Pk "$FALAK_DIR" | awk 'NR==2 {print int($4/1024/1024)}')"
  if [ "${avail:-0}" -lt 5 ]; then bad "only ${avail} GB free on $FALAK_DIR"; problems=$((problems + 1)); else ok "${avail} GB free on $FALAK_DIR"; fi
  if [ -r /proc/meminfo ]; then ok "$(awk '/MemTotal/ {t=$2} /MemAvailable/ {a=$2} END {printf "%.1f GB RAM, %.1f GB available", t/1048576, a/1048576}' /proc/meminfo)"; fi

  info "Backups"
  local last
  last="$(latest_backup)"
  if [ -z "$last" ]; then warn "no backups yet — run falak-ctl backup (and copy it off this host)"; problems=$((problems + 1))
  else ok "latest: $(basename "$last")"; fi

  say
  if [ "$problems" = 0 ]; then ok "no problems found"; else warn "$problems problem(s) found"; return 1; fi
}

resolve() {
  if command -v dig >/dev/null 2>&1; then
    { dig +short A "$1"; dig +short AAAA "$1"; } 2>/dev/null | grep -E '^[0-9a-fA-F:.]+$' || true
  else
    getent ahosts "$1" 2>/dev/null | awk '{print $1}' | sort -u || true
  fi
}

port_listening() {
  if command -v ss >/dev/null 2>&1; then ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
  else (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
  fi
}

cert_field() { # cert_field HOST -enddate|-issuer
  local port; port="$(https_port)"
  echo | openssl s_client -connect "127.0.0.1:$port" -servername "$1" 2>/dev/null | openssl x509 -noout "$2" 2>/dev/null
}

days_left() { # days_left "Mon DD HH:MM:SS YYYY GMT" MIN_DAYS
  local end_s now_s
  end_s="$(date -d "$1" +%s 2>/dev/null || date -j -f '%b %e %T %Y %Z' "$1" +%s 2>/dev/null || echo 0)"
  now_s="$(date +%s)"
  [ $(( (end_s - now_s) / 86400 )) -ge "$2" ]
}

cmd_domain() {
  require_install
  [ "${1:-}" = "set" ] || die "usage: falak-ctl domain set <new-domain> [--keep-old]"
  shift
  local new="" keep_old=0
  while [ $# -gt 0 ]; do
    case "$1" in --keep-old) keep_old=1 ;; -*) die "unknown option $1" ;; *) new="$1" ;; esac
    shift
  done
  [ -n "$new" ] || die "usage: falak-ctl domain set <new-domain> [--keep-old]"
  local old old_agents port suffix
  old="$(env_get FALAK_DOMAIN)"; old_agents="$(env_get FALAK_AGENT_API_HOST)"
  port="$(https_port)"; suffix=""; [ "$port" != 443 ] && suffix=":$port"
  info "moving the panel from $old to $new"
  cmd_backup --label "pre-domain-change" --quiet
  env_set FALAK_DOMAIN "$new"
  env_set FALAK_URL "https://$new$suffix"
  env_set FALAK_AGENT_API_HOST "agents.$new"
  env_set FALAK_AGENT_API_URL "https://agents.$new$suffix/agent/v1"
  # Enrolled agents keep calling the agent API host they enrolled with: keep serving it.
  local aliases
  aliases="$(env_get FALAK_AGENT_API_HOST_ALIASES)"
  case ",$aliases," in *",$old_agents,"*) ;; *) aliases="${aliases:+$aliases,}$old_agents" ;; esac
  env_set FALAK_AGENT_API_HOST_ALIASES "$aliases"
  if [ "$keep_old" = 1 ]; then env_set FALAK_DOMAIN_ALIASES "$old"; fi
  local old_registry
  old_registry="$(env_get FALAK_REGISTRY_HOST)"
  if [ -n "$old_registry" ]; then
    # Images of earlier releases keep pulling from the old name (served as an alias; keep its DNS record).
    env_set FALAK_REGISTRY_HOST "registry.$new"
    env_set FALAK_REGISTRY_URL "registry.$new$suffix"
    aliases="$(env_get FALAK_REGISTRY_HOST_ALIASES)"
    case ",$aliases," in *",$old_registry,"*) ;; *) aliases="${aliases:+$aliases,}$old_registry" ;; esac
    env_set FALAK_REGISTRY_HOST_ALIASES "$aliases"
  fi
  if [ -n "$(env_get FALAK_GRAFANA_HOST)" ]; then
    env_set FALAK_GRAFANA_HOST "grafana.$new"
    env_set FALAK_GRAFANA_PUBLIC_URL "https://grafana.$new$suffix"
  fi
  [ -n "$(env_get FALAK_OTLP_ENDPOINT)" ] && env_set FALAK_OTLP_ENDPOINT "https://$new$suffix/otlp"
  ensure_registry_env
  wait_healthy 420
  health_check || true
  ok "panel: https://$new$suffix"
  say "  Keep DNS for $old_agents pointing here: enrolled agents still use it (served as an alias)."
  [ -n "$old_registry" ] && say "  Add DNS for registry.$new; keep $old_registry pointing here (images of earlier releases)."
  say "  New servers enroll against https://$new$suffix; update CLI logins (falak login --url ...)."
}

cmd_admin() {
  require_install
  local sub="${1:-}"; shift || true
  case "$sub" in
    reset-password)
      [ -n "${1:-}" ] || die "usage: falak-ctl admin reset-password <email> [--password=...]"
      compose exec -T control-plane php artisan falak:admin "$@" --reset-password ;;
    create)
      [ -n "${1:-}" ] || die "usage: falak-ctl admin create <email> [--organization=...] [--token=name]"
      compose exec -T control-plane php artisan falak:admin "$@" ;;
    *) die "usage: falak-ctl admin reset-password|create <email>" ;;
  esac
}

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    up) require_install; ensure_registry_env
        pull_images missing || die "pulling images failed (see above); nothing was started"
        wait_healthy "${1:-420}" && health_check ;;
    down) require_install; compose down ;;
    restart) require_install; compose restart "$@" ;;
    update|upgrade) cmd_update "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    doctor) cmd_doctor "$@" ;;
    domain) cmd_domain "$@" ;;
    admin) cmd_admin "$@" ;;
    artisan) require_install; compose exec control-plane php artisan "$@" ;;
    compose) require_install; compose "$@" ;;
    health) require_install; health_check ;;
    reload-configs) require_install; recreate_drifted 300 ;;
    registry) cmd_registry "$@" ;;
    prune-images) cmd_prune_images "$@" ;;
    version) require_install; env_get FALAK_VERSION; echo ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}

# Sourced by deploy/tests/*.sh for function-level tests.
if [ "${FALAK_CTL_SOURCED:-0}" != 1 ]; then main "$@"; fi
