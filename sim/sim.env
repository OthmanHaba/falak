# Kiln local simulation settings (non-secret, sim only). Used by compose.yml via --env-file
# and by the included observability stack.

# Host ports (chosen to avoid clashing with a standalone observability stack or other apps).
SIM_EDGE_HTTPS_PORT=8443
KILN_OTLP_PORT=14318
KILN_GRAFANA_PORT=13000
KILN_LOKI_PORT=13100
KILN_TEMPO_PORT=13200
KILN_METRICS_QUERY_PORT=19090
KILN_OBSERVABILITY_NETWORK=kiln-sim-observability

# Agent binary variant mounted into the sim servers: arm64 | amd64
SIM_AGENT_ARCH=arm64
# Optional: public key authorised for root@srv-* (SSH bootstrap fallback testing).
SIM_SSH_PUBKEY=

# Secrets (APP_KEY, REVERB_*) are generated on first run into .data/secrets.env (gitignored).
